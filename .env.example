# 環境変数の設定（ひな形）
# このファイルを .env.local という名前でコピーし、= の右側に自分のキーを書いてください。
# .env.local は .gitignore で除外されているので GitHub にはアップロードされません。
# ※ キーの名前に NEXT_PUBLIC_ を付けないこと（付けるとブラウザに公開されてしまいます）

# サイトを開くときの合言葉。本番（Vercel など）では必ず設定してください。
# 未設定だと、本番ではサイトが使えない状態になります（npm run dev ではログイン不要）。
# 推測されにくい 12 文字以上がおすすめです。
APP_PASSWORD=

# 楽天ウェブサービスのアプリケーション ID とアクセスキー（楽天市場の価格・ポイントを調べるとき）
# 2026 年の楽天 API 移行で両方が必要になりました。同じアプリで発行された組み合わせを設定してください。
RAKUTEN_APP_ID=
RAKUTEN_ACCESS_KEY=
# 楽天のアプリ設定の「許可されたWebサイト」に登録した URL（任意。未設定ならこのサイト自身の URL を使う）
RAKUTEN_SITE_URL=
# 楽天アフィリエイト ID（任意。設定すると商品リンクがアフィリエイトリンクになる）
RAKUTEN_AFFILIATE_ID=

# Yahoo!デベロッパーネットワークの Client ID（Yahoo!ショッピングの価格・ポイントを調べるとき）
YAHOO_CLIENT_ID=

# Amazon Selling Partner API（SP-API）のキー（Amazon の価格・売れ筋ランキング・FBA 手数料を調べるとき）
# セラーセントラルの大口出品アカウントで「アプリとサービス → アプリの開発」から自分用のアプリを登録し、
# 「商品の価格設定」「商品カタログ」のロールを付けて承認すると発行されます。
# 3 つとも未設定なら Amazon を使わず、楽天・Yahoo! だけで比較します。
AMAZON_SP_CLIENT_ID=
AMAZON_SP_CLIENT_SECRET=
AMAZON_SP_REFRESH_TOKEN=
