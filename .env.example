# 環境変数の設定（ひな形）
# このファイルを .env.local という名前でコピーし、= の右側に自分のキーを書いてください。
# .env.local は .gitignore で除外されているので GitHub にはアップロードされません。
# ※ キーの名前に NEXT_PUBLIC_ を付けないこと（付けるとブラウザに公開されてしまいます）

# Sandbox（テスト用）か Production（本番）か
EBAY_ENVIRONMENT=sandbox

# eBay Developers Program の「Application Keys」に表示される値
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# サイトを開くときの合言葉。本番（Vercel など）では必ず設定してください。
# 未設定だと、本番ではサイトが使えない状態になります（npm run dev ではログイン不要）。
# 推測されにくい 12 文字以上がおすすめです。
APP_PASSWORD=

# 楽天ウェブサービスのアプリ ID（自動リサーチで楽天市場を検索するとき）
RAKUTEN_APP_ID=
# 楽天の新しい API（openapi.rakuten.co.jp）用のアクセスキー。発行されている場合だけ設定（任意）
RAKUTEN_ACCESS_KEY=
# 楽天アフィリエイト ID（任意。設定すると商品リンクがアフィリエイトリンクになる）
RAKUTEN_AFFILIATE_ID=

# Yahoo!デベロッパーネットワークの Client ID（自動リサーチで Yahoo!ショッピングを検索するとき）
YAHOO_CLIENT_ID=
