# eBay API の設定（ひな形）
# このファイルを .env.local という名前でコピーし、= の右側に自分のキーを書いてください。
# .env.local は .gitignore で除外されているので GitHub にはアップロードされません。
# ※ キーの名前に NEXT_PUBLIC_ を付けないこと（付けるとブラウザに公開されてしまいます）

# Sandbox（テスト用）か Production（本番）か。キーの種類に合わせる（未設定なら sandbox）
EBAY_ENVIRONMENT=sandbox

# eBay Developers Program の「Application Keys」に表示される値
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
